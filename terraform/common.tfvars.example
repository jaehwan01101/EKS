# 모든 레이어가 공유하는 값. common.tfvars 로 복사해서 채운다.
#   terraform plan -var-file=../common.tfvars
# 레이어가 선언하지 않은 변수는 경고만 나고 무시된다.

project      = "reservation"
region       = "ap-northeast-2"
domain_name  = "example.com"                      # Route 53에 호스팅 영역이 이미 있어야 함
state_bucket = "reservation-tfstate-123456789012" # 00-bootstrap output
